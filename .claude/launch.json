{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "insulator-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5174
    },
    {
      "name": "insulator-backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m", "uvicorn",
        "--app-dir", "backend",
        "app.main:app",
        "--host", "127.0.0.1",
        "--port", "8001"
      ],
      "port": 8001
    }
  ]
}
