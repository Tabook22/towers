# Copy this file to `backend/.env` and fill in real values before running in production.
# Never commit the real `backend/.env` — it's already in the root .gitignore.

# A long, random, unguessable string used to sign login sessions (JWTs). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The default baked into app/config.py is a placeholder for local development ONLY — using it in
# production would let anyone forge a valid login for any account.
SECRET_KEY=change-me-to-a-long-random-string

# JSON array of the exact origin(s) your frontend is served from — the browser will refuse cross-
# origin requests to the API from anywhere not listed here. Include the scheme, no trailing slash.
CORS_ORIGINS=["https://your-domain.com"]

# Optional — defaults to a SQLite file under backend/storage/ if unset, which is fine for a single
# small VPS. Only set this if you're pointing at a different database.
# DATABASE_URL=sqlite:////absolute/path/to/insulator_inspector.db

# Optional — powers the Help page's chat assistant (routers/help_chat.py). Get a key at
# https://console.anthropic.com/settings/keys. Left unset, the chat just returns a clear
# "not set up yet" message instead of failing.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
